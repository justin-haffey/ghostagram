@page "/"

<PageTitle>Diagram Studio</PageTitle>

<div class="home-page">
    <section class="hero-card">
        <div class="eyebrow">Diagram Studio</div>
        <h1>Professional diagramming built for technical teams.</h1>
        <p>
            Design flowcharts, ERDs, UML, networks, data flows, mind maps, org charts, and state diagrams
            in one polished workspace powered by Blazor and jsPlumb.
        </p>
        <div class="hero-actions">
            <a class="hero-button hero-button--primary" href="/documents">Open Workspace</a>
            <a class="hero-button" href="/editor">Open Latest Diagram</a>
            <a class="hero-button" href="/healthz">Health Check</a>
        </div>
    </section>

    <section class="template-strip" aria-label="Built-in templates">
        <article>Flowchart</article>
        <article>Org Chart</article>
        <article>UML Class</article>
        <article>UML Sequence</article>
        <article>ERD</article>
        <article>C4 Context</article>
        <article>BPMN Lite</article>
        <article>Network</article>
        <article>Mind Map</article>
        <article>Data Flow</article>
        <article>State</article>
    </section>
</div>

<style>
    .home-page {
        display: grid;
        gap: 2rem;
        margin: 0 auto;
        max-width: 1200px;
        min-height: 100vh;
        padding: 4rem 1.5rem 3rem;
        place-content: center;
    }

    .hero-card {
        background: rgba(250, 249, 245, 0.82);
        border: 1px solid rgba(67, 81, 98, 0.18);
        border-radius: 2rem;
        box-shadow: var(--studio-shadow);
        padding: clamp(2rem, 4vw, 4rem);
        position: relative;
        overflow: hidden;
    }

    .hero-card::after {
        background:
            linear-gradient(90deg, rgba(44, 168, 160, 0.16) 0, rgba(44, 168, 160, 0.16) 1px, transparent 1px, transparent 42px),
            linear-gradient(rgba(44, 168, 160, 0.12) 0, rgba(44, 168, 160, 0.12) 1px, transparent 1px, transparent 42px);
        content: "";
        inset: 0;
        opacity: 0.4;
        pointer-events: none;
        position: absolute;
    }

    .hero-card > * {
        position: relative;
        z-index: 1;
    }

    .eyebrow {
        color: var(--studio-accent-strong);
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    h1 {
        font-size: clamp(2.6rem, 6vw, 5.2rem);
        line-height: 0.96;
        margin: 0;
        max-width: 11ch;
    }

    p {
        color: var(--studio-text-soft);
        font-size: 1.05rem;
        line-height: 1.7;
        margin: 1.5rem 0 0;
        max-width: 56rem;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
    }

    .hero-button {
        border: 1px solid rgba(31, 37, 48, 0.16);
        border-radius: 999px;
        color: var(--studio-text);
        display: inline-flex;
        font-weight: 700;
        padding: 0.95rem 1.4rem;
        text-decoration: none;
    }

    .hero-button--primary {
        background: linear-gradient(135deg, var(--studio-accent) 0%, var(--studio-accent-strong) 100%);
        border-color: transparent;
        color: white;
    }

    .template-strip {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    }

    .template-strip article {
        backdrop-filter: blur(14px);
        background: rgba(31, 37, 48, 0.84);
        border: 1px solid rgba(250, 249, 245, 0.08);
        border-radius: 1.2rem;
        color: var(--studio-white);
        font-family: "IBM Plex Mono", monospace;
        padding: 1rem;
        text-align: center;
    }
</style>
