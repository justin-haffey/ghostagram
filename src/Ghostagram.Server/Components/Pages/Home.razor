@page "/"
@rendermode InteractiveServer
@using Ghostagram.Blazor
@using Ghostagram.Core

<PageTitle>Ghostagram Laboratory</PageTitle>

<div class="laboratory-root">
    <MudLayout Class="@($"laboratory-layout {(_palettePinned && _paletteOpen ? "palette-docked" : string.Empty)}")">
        <MudAppBar Fixed="true" Elevation="0" Dense="true" Class="laboratory-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="TogglePalette" aria-label="Toggle node palette" />
            <div class="laboratory-brand" aria-label="Ghostagram laboratory">
                <span class="laboratory-brand-mark" aria-hidden="true"></span>
                <MudText Typo="Typo.h6">Ghostagram</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit">Laboratory</MudChip>
            </div>

            <MudMenu Label="File" Color="Color.Inherit" Dense="true">
                <MudMenuItem OnClick="OpenNewDiagram" Icon="@Icons.Material.Filled.NoteAdd">New diagram…</MudMenuItem>
                <MudMenuItem OnClick="SaveCurrentAsync" Icon="@Icons.Material.Filled.Save">Save</MudMenuItem>
                <MudMenuItem OnClick="OpenSaveAs" Icon="@Icons.Material.Filled.SaveAs">Save as…</MudMenuItem>
                <MudMenuItem OnClick="OpenDiagramLibraryAsync" Icon="@Icons.Material.Filled.FolderOpen">Open diagram…</MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="ExportImageAsync" Icon="@Icons.Material.Filled.Image">Export image…</MudMenuItem>
                <MudMenuItem OnClick="CopyViewportAsync" Icon="@Icons.Material.Filled.ContentCopy">Copy viewport</MudMenuItem>
                <MudMenuItem OnClick="ExportAsync" Icon="@Icons.Material.Filled.Code">Export SVG</MudMenuItem>
                <MudMenuItem OnClick="ResetAsync" Icon="@Icons.Material.Filled.RestartAlt">Reset starter design</MudMenuItem>
            </MudMenu>
            <MudMenu Label="Insert" Color="Color.Inherit" Dense="true">
                <MudMenuItem OnClick="OpenDesigner" Icon="@Icons.Material.Filled.AddBox">Node typeâ€¦</MudMenuItem>
                <MudMenuItem OnClick="OpenPaletteGroupEditor" Icon="@Icons.Material.Filled.CreateNewFolder">Palette group</MudMenuItem>
                <MudMenuItem OnClick="AddGroupAsync" Icon="@Icons.Material.Filled.SelectAll">Canvas group</MudMenuItem>
            </MudMenu>
            <MudMenu Label="Palette" Color="Color.Inherit" Dense="true">
                <MudMenuItem OnClick="SavePaletteAsync" Icon="@Icons.Material.Filled.Save">Save palette</MudMenuItem>
                <MudMenuItem OnClick="OpenPaletteSaveAsAsync" Icon="@Icons.Material.Filled.SaveAs">Save palette as…</MudMenuItem>
                <MudMenuItem OnClick="OpenPaletteLibraryAsync" Icon="@Icons.Material.Filled.FolderOpen">Open palette…</MudMenuItem>
            </MudMenu>
            <MudMenu Label="Edit" Color="Color.Inherit" Dense="true">
                <MudMenuItem OnClick="OpenNodeStyleEditor" Disabled="@(!CanEditSelectedNode)" Icon="@Icons.Material.Filled.Palette">Node style</MudMenuItem>
                <MudMenuItem OnClick="OpenNodePropertiesEditor" Disabled="@(!CanEditSelectedNode)" Icon="@Icons.Material.Filled.Tune">Node detailsâ€¦</MudMenuItem>
                <MudMenuItem OnClick="AddSelectedNodeToPaletteAsync" Disabled="@(!CanCaptureSelectedNode)" Icon="@Icons.Material.Filled.LibraryAdd">Add selected node to palette</MudMenuItem>
                <MudMenuItem OnClick="DeleteSelectedAsync" Disabled="@(!_document.Selection.Any())" Icon="@Icons.Material.Filled.DeleteOutline">Delete selected</MudMenuItem>
                <MudMenuItem OnClick="RemoveSelectedGroupFramesAsync" Disabled="@(!HasSelectedGroups)" Icon="@Icons.Material.Filled.FolderOff">Remove group frame</MudMenuItem>
                <MudMenuItem OnClick="UndoAsync" Disabled="@(!_undo.Any())" Icon="@Icons.Material.Filled.Undo">Undo</MudMenuItem>
                <MudMenuItem OnClick="RedoAsync" Disabled="@(!_redo.Any())" Icon="@Icons.Material.Filled.Redo">Redo</MudMenuItem>
            </MudMenu>
            <MudMenu Label="View" Color="Color.Inherit" Dense="true">
                <MudMenuItem OnClick="TogglePalette" Icon="@Icons.Material.Filled.AccountTree">Node palette</MudMenuItem>
                <MudMenuItem OnClick="FitAsync" Icon="@Icons.Material.Filled.CenterFocusStrong">Frame diagram</MudMenuItem>
            </MudMenu>

            <MudSpacer />
            <MudText Typo="Typo.caption" Class="appbar-revision">@_documentDisplayName · Revision @_revision</MudText>
        </MudAppBar>

        <MudDrawer @bind-Open="_paletteOpen"
                   Variant="DrawerVariant.Temporary"
                   Anchor="Anchor.Left"
                   ClipMode="DrawerClipMode.Always"
                   Overlay="false"
                   Elevation="2"
                   Class="laboratory-palette"
                   Width="288px">
            <GhostPalette @ref="_palette"
                          Title="@_paletteCatalogName"
                          Groups="PaletteGroups"
                          Items="PaletteItems"
                          ItemDropped="DropPaletteItemAsync"
                          ItemInvoked="InvokePaletteItemAsync"
                          ItemMoved="MovePaletteItemAsync"
                          ItemDeleteRequested="DeleteCustomTemplate"
                          GroupDeleteRequested="RemovePaletteGroup"
                          GroupExpandedChanged="SetCategoryExpanded">
                <HeaderActions>
                    <MudTooltip Text="Add a palette group">
                        <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" OnClick="OpenPaletteGroupEditor" aria-label="Add a palette group" />
                    </MudTooltip>
                    <MudIconButton Icon="@(_palettePinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                                   Color="@(_palettePinned ? Color.Primary : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="TogglePalettePin"
                                   aria-label="@(_palettePinned ? "Unpin palette" : "Pin palette")" />
                </HeaderActions>
                <ItemIcon Context="item">
                    <MudIcon Icon="@TemplateIcon(item.Id)" Size="Size.Medium" />
                </ItemIcon>
                <FooterContent>
                    <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddBox" OnClick="OpenDesigner">
                        Design a node type
                    </MudButton>
                </FooterContent>
            </GhostPalette>
        </MudDrawer>

        <MudMainContent Class="laboratory-main">
            <section class="laboratory-toolbar" aria-label="Diagram controls">
                <div class="toolbar-group toolbar-layout">
                    <MudSelect T="string" @bind-Value="_layoutDirection" Label="Sort direction" Dense="true" Variant="Variant.Outlined" Class="toolbar-select">
                        <MudSelectItem T="string" Value="@("right")">Left to right</MudSelectItem>
                        <MudSelectItem T="string" Value="@("down")">Top to bottom</MudSelectItem>
                        <MudSelectItem T="string" Value="@("left")">Right to left</MudSelectItem>
                        <MudSelectItem T="string" Value="@("up")">Bottom to top</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="ApplyLayoutAsync">Sort layout</MudButton>
                </div>

                <MudDivider Vertical="true" FlexItem="true" />

                <div class="toolbar-group toolbar-edge">
                    <MudSelect T="string" Value="_edgeConnector" ValueChanged="OnEdgeConnectorChangedAsync" Label="Edge shape" Dense="true" Variant="Variant.Outlined" Class="toolbar-select edge-select">
                        <MudSelectItem T="string" Value="@("flowchart")">Square</MudSelectItem>
                        <MudSelectItem T="string" Value="@("straight")">Straight</MudSelectItem>
                        <MudSelectItem T="string" Value="@("bezier")">Bezier</MudSelectItem>
                        <MudSelectItem T="string" Value="@("curved")">Curved</MudSelectItem>
                    </MudSelect>
                    <label class="edge-color-control" title="Change selected edge color">
                        <span>Color</span>
                        <input type="color" value="@_edgeColor" @onchange="OnEdgeColorChangedAsync" disabled="@(!HasSelectedEdges)" aria-label="Change selected edge color" />
                    </label>
                    <MudSelect T="string" Value="_edgeStartMarker" ValueChanged="OnEdgeStartMarkerChangedAsync" Label="Start marker" Dense="true" Variant="Variant.Outlined" Class="toolbar-select marker-select">
                        @foreach (var marker in EdgeMarkerChoices)
                        {
                            <MudSelectItem T="string" Value="@marker.Id">@marker.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Value="_edgeEndMarker" ValueChanged="OnEdgeEndMarkerChangedAsync" Label="End marker" Dense="true" Variant="Variant.Outlined" Class="toolbar-select marker-select">
                        @foreach (var marker in EdgeMarkerChoices)
                        {
                            <MudSelectItem T="string" Value="@marker.Id">@marker.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch T="bool" Value="_edgeAnimated" ValueChanged="OnEdgeAnimatedChangedAsync" Color="Color.Secondary" Label="Animated" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Timeline" OnClick="ApplyEdgeSettingsAsync" Disabled="@(!_document.Edges.Any())">
                        @EdgeApplyLabel
                    </MudButton>
                </div>

                <MudSpacer />

                <MudTooltip Text="Edit the selected node's appearance">
                    <MudIconButton Icon="@Icons.Material.Filled.Palette" Color="Color.Primary" OnClick="OpenNodeStyleEditor" Disabled="@(!CanEditSelectedNode)" aria-label="Edit selected node style" />
                </MudTooltip>
                <MudTooltip Text="Edit selected-node presentation, properties, and connection points">
                    <MudIconButton Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" OnClick="OpenNodePropertiesEditor" Disabled="@(!CanEditSelectedNode)" aria-label="Edit selected node details" />
                </MudTooltip>
                <MudTooltip Text="Add the selected node to the Custom palette group">
                    <MudIconButton Icon="@Icons.Material.Filled.LibraryAdd" Color="Color.Primary" OnClick="AddSelectedNodeToPaletteAsync" Disabled="@(!CanCaptureSelectedNode)" aria-label="Add selected node to palette" />
                </MudTooltip>
                <MudTooltip Text="Delete the current node, group, or edge selection">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="DeleteSelectedAsync" Disabled="@(!_document.Selection.Any())" aria-label="Delete selected" />
                </MudTooltip>
                <MudTooltip Text="Frame the whole diagram">
                    <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" OnClick="FitAsync" aria-label="Frame diagram" />
                </MudTooltip>
            </section>

            <section class="laboratory-canvas-card" aria-label="Diagram canvas">
                <header class="canvas-statusbar">
                    <div class="canvas-status-copy">
                        <span class="status-dot @(_busy ? "is-busy" : string.Empty)"></span>
                        <span>@_activity</span>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_document.Nodes.Count nodes</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_document.Edges.Count edges</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_document.Groups.Count groups</MudChip>
                </header>

                <div @ref="_canvasDropZone" class="laboratory-canvas" data-ghostagram-drop-zone>
                    <GhostDiagram @ref="_diagram"
                                  Document="@_document"
                                  Revision="@_revision"
                                  Options="@_options"
                                  EventReceived="OnGhostagramEvent"
                                  AriaLabel="Interactive Ghostagram design canvas" />
                    <div @ref="_canvasDropOverlay" class="canvas-drop-overlay" data-ghostagram-drop-overlay>
                        <MudIcon Icon="@Icons.Material.Filled.AddToPhotos" />
                        <span>Drop to add node</span>
                    </div>
                </div>

                <footer class="canvas-footer">
                    <span>Drag nodes and groups · Ctrl-drag duplicates nodes or group contents · Shift-drag to select · F2 edits labels · Delete removes a selection</span>
                    <span>Changes save automatically</span>
                </footer>
            </section>
        </MudMainContent>
    </MudLayout>

    @if (_isSaveAsOpen)
    {
        <div class="studio-modal-backdrop" @onclick="CloseSaveAs">
            <MudPaper Class="studio-modal compact-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Save diagram as" @onclick:stopPropagation="true">
                <header class="studio-modal-header">
                    <div><MudText Typo="Typo.h6">Save diagram as</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Create an independent, fully editable diagram.</MudText></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseSaveAs" aria-label="Close save dialog" />
                </header>
                <MudTextField @bind-Value="_saveAsName" Label="Diagram name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" />
                <footer class="studio-modal-actions">
                    <MudButton OnClick="CloseSaveAs">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SaveAs" OnClick="SaveAsAsync">Save and open</MudButton>
                </footer>
            </MudPaper>
        </div>
    }

    @if (_isNewDiagramOpen)
    {
        <div class="studio-modal-backdrop" @onclick="CloseNewDiagram">
            <MudPaper Class="studio-modal compact-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Create new diagram" @onclick:stopPropagation="true">
                <header class="studio-modal-header">
                    <div><MudText Typo="Typo.h6">New diagram</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Start with a blank, saved diagram.</MudText></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseNewDiagram" aria-label="Close new diagram dialog" />
                </header>
                <MudTextField @bind-Value="_newDiagramName" Label="Diagram name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" />
                <footer class="studio-modal-actions">
                    <MudButton OnClick="CloseNewDiagram">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.NoteAdd" OnClick="CreateNewDiagramAsync">Create and open</MudButton>
                </footer>
            </MudPaper>
        </div>
    }

    @if (_isDiagramLibraryOpen)
    {
        <div class="studio-modal-backdrop" @onclick="CloseDiagramLibrary">
            <MudPaper Class="studio-modal library-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Open diagram" @onclick:stopPropagation="true">
                <header class="studio-modal-header">
                    <div><MudText Typo="Typo.h6">Open diagram</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Saved diagrams remain editable, collaborative, and revisioned.</MudText></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseDiagramLibrary" aria-label="Close diagram library" />
                </header>
                <div class="library-list">
                    @foreach (var document in _documents)
                    {
                        <MudPaper Class="library-item" Outlined="true">
                            <div class="library-item-copy">
                                <MudText Typo="Typo.subtitle2">@document.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Revision @document.Revision · @document.UpdatedUtc.LocalDateTime.ToString("g")</MudText>
                            </div>
                            @if (document.DocumentId == DocumentId)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Open</MudChip>
                            }
                            else
                            {
                                <div class="library-item-actions">
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="@(() => OpenDocumentAsync(document.DocumentId))">Open</MudButton>
                                    <MudTooltip Text="Delete this diagram">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => OpenDeleteDiagram(document))" aria-label="@($"Delete {document.DisplayName}")" />
                                    </MudTooltip>
                                </div>
                            }
                        </MudPaper>
                    }
                </div>
            </MudPaper>
        </div>
    }

    @if (_isPaletteSaveAsOpen)
    {
        <div class="studio-modal-backdrop" @onclick="ClosePaletteSaveAs">
            <MudPaper Class="studio-modal compact-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Save palette as" @onclick:stopPropagation="true">
                <header class="studio-modal-header">
                    <div><MudText Typo="Typo.h6">Save palette as</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Copy custom groups, node definitions, organization, and open folders.</MudText></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClosePaletteSaveAs" aria-label="Close palette save dialog" />
                </header>
                <MudTextField @bind-Value="_paletteSaveAsName" Label="Palette name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" />
                <footer class="studio-modal-actions">
                    <MudButton OnClick="ClosePaletteSaveAs">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SaveAs" OnClick="SavePaletteAsAsync">Save and open</MudButton>
                </footer>
            </MudPaper>
        </div>
    }

    @if (_isPaletteLibraryOpen)
    {
        <div class="studio-modal-backdrop" @onclick="ClosePaletteLibrary">
            <MudPaper Class="studio-modal library-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Open palette" @onclick:stopPropagation="true">
                <header class="studio-modal-header">
                    <div><MudText Typo="Typo.h6">Open palette</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Switch node libraries without changing the open diagram.</MudText></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClosePaletteLibrary" aria-label="Close palette library" />
                </header>
                <div class="library-list">
                    @foreach (var palette in _paletteCatalogSummaries)
                    {
                        <MudPaper Class="library-item" Outlined="true">
                            <div class="library-item-copy">
                                <MudText Typo="Typo.subtitle2">@palette.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@palette.CustomGroupCount custom groups · @palette.CustomNodeCount custom nodes · Revision @palette.Revision</MudText>
                            </div>
                            @if (palette.CatalogId == _paletteCatalogId)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Open</MudChip>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="@(() => OpenPaletteCatalogAsync(palette.CatalogId))">Open</MudButton>
                            }
                        </MudPaper>
                    }
                </div>
            </MudPaper>
        </div>
    }

    @if (_isDesignerOpen)
    {
        <div class="studio-modal-backdrop" @onclick="CloseDesigner">
        <MudPaper Class="studio-modal designer-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Node designer" @onclick:stopPropagation="true">
        <header class="studio-modal-header">
            <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.DesignServices" Class="mr-2" />Node designer</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseDesigner" aria-label="Close node designer" />
        </header>
        <div class="studio-modal-content">
            <div class="node-designer-layout">
            <div class="node-designer-authoring">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Start with a lightweight node. Organize properties into nested, collapsible sections only when the node needs them.
            </MudText>
            <MudGrid Spacing="1">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_draft.Label" Label="Node name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_draft.Icon" Label="Node icon preset" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" aria-label="Choose an Iconify node icon preset">
                        <MudSelectItem T="string" Value="@("mdi:shape-outline")">Generic shape</MudSelectItem>
                        <MudSelectItem T="string" Value="@("mdi:account-voice")">Voice agent</MudSelectItem>
                        <MudSelectItem T="string" Value="@("mdi:robot-outline")">Agent</MudSelectItem>
                        <MudSelectItem T="string" Value="@("mdi:database-outline")">Data</MudSelectItem>
                        <MudSelectItem T="string" Value="@("mdi:form-textbox")">Capture</MudSelectItem>
                        <MudSelectItem T="string" Value="@("mdi:message-processing-outline")">Message</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_draft.Icon" Label="Iconify icon name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="For example: mdi:robot-outline" aria-label="Iconify icon name" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="double" @bind-Value="_draft.Width" Label="Width" Margin="Margin.Dense" Min="96" Max="360" Step="8" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="double" @bind-Value="_draft.Height" Label="Height" Margin="Margin.Dense" Min="48" Max="420" Step="8" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="_draft.Category" Label="Palette group" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                        @foreach (var category in _paletteCategories)
                        {
                            <MudSelectItem T="string" Value="@category.Name">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="_draft.Direction" Label="New point direction" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("both")">Both</MudSelectItem>
                        <MudSelectItem T="string" Value="@("source")">Output</MudSelectItem>
                        <MudSelectItem T="string" Value="@("target")">Input</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <div class="designer-color-field">
                        <label for="node-outline-color">Outline</label>
                        <div class="designer-color-control">
                            <input id="node-outline-color" type="color" @bind="_draft.Outline" @bind:event="oninput" aria-label="Select node outline color" />
                            <MudTextField @bind-Value="_draft.Outline" Label="Hex" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <div class="designer-color-field">
                        <label for="node-background-color">Background</label>
                        <div class="designer-color-control">
                            <input id="node-background-color" type="color" @bind="_draft.Background" @bind:event="oninput" aria-label="Select node background color" />
                            <MudTextField @bind-Value="_draft.Background" Label="Hex" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <div class="designer-color-field">
                        <label for="node-text-color">Text</label>
                        <div class="designer-color-control">
                            <input id="node-text-color" type="color" @bind="_draft.TextColor" @bind:event="oninput" aria-label="Select node text color" />
                            <MudTextField @bind-Value="_draft.TextColor" Label="Hex" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="_draft.TextAlign" Label="Text alignment" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("left")">Left</MudSelectItem>
                        <MudSelectItem T="string" Value="@("center")">Center</MudSelectItem>
                        <MudSelectItem T="string" Value="@("right")">Right</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <section class="designer-properties" aria-label="Node properties">
                <div class="designer-properties-header">
                    <div>
                        <MudText Typo="Typo.subtitle2">Content</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Simple nodes stay flat. Turn on organization only when properties need a hierarchy.</MudText>
                    </div>
                    <MudSwitch T="bool" Value="@_draft.IsOrganized" ValueChanged="SetDraftOrganized" Color="Color.Primary" Label="Organize with sections" />
                </div>
                @if (_draft.IsOrganized)
                {
                    <div class="designer-sections" aria-label="Section hierarchy">
                        <div class="designer-properties-header"><div><MudText Typo="Typo.subtitle2">Sections</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Parent references determine nesting; the order shown becomes the node order.</MudText></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="AddDraftSection">Add section</MudButton></div>
                        @foreach (var section in _draftSections)
                        {
                            <div class="designer-section-row" @key="section.Id">
                                <MudTextField @bind-Value="section.Title" Label="Section title" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                <MudSelect T="string" @bind-Value="section.ParentSectionId" Label="Parent" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Clearable="true">
                                    @foreach (var parent in _draftSections.Where(parent => parent.Id != section.Id)) { <MudSelectItem T="string" Value="@parent.Id">@parent.Title</MudSelectItem> }
                                </MudSelect>
                                <MudCheckBox @bind-Value="section.Collapsible" Label="Collapsible" Dense="true" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveDraftSection(section.Id))" aria-label="Remove section" />
                            </div>
                        }
                    </div>
                }
                <div class="designer-properties-header designer-properties-subheader"><div><MudText Typo="Typo.subtitle2">Properties</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Connectable properties receive left/right ports. Editor choices are validated against type.</MudText></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddDraftProperty">Add property</MudButton></div>
                @if (_draftProperties.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No properties yet. Add one to expose a typed value on nodes created from this type.</MudText>
                }
                @foreach (var property in _draftProperties)
                {
                    <div class="designer-property-row" @key="property.Id">
                        <MudTextField @bind-Value="property.Name" Label="Name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        <MudSelect T="string" @bind-Value="property.Type" Label="Type" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.String">Text</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.Boolean">Boolean</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.Integer">Integer</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.Decimal">Number</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.Date">Date</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.DateTime">Date/time</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.Enum">Choice</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyTypes.Json">JSON</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="property.Mode" Label="Node mode" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@DiagramPropertyModes.Display">Display</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyModes.Edit">Edit</MudSelectItem>
                            <MudSelectItem T="string" Value="@DiagramPropertyModes.DisplayAndEdit">Display and edit</MudSelectItem>
                        </MudSelect>
                        @if (_draft.IsOrganized)
                        {
                            <MudSelect T="string" @bind-Value="property.SectionId" Label="Section" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Clearable="true">
                                @foreach (var section in _draftSections) { <MudSelectItem T="string" Value="@section.Id">@section.Title</MudSelectItem> }
                            </MudSelect>
                        }
                        <MudSelect T="string" @bind-Value="property.EditorKind" Label="Editor" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Auto">Automatic</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Text">Text</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Multiline">Multiline</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Toggle">Toggle</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Number">Number</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Range">Range</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Date">Date</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.DateTime">Date/time</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Select">Select</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Color">Color</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Json">JSON</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="property.DefaultValue" Label="Default" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        @if (property.Type == DiagramPropertyTypes.Enum)
                        {
                            <MudTextField @bind-Value="property.Options" Label="Choices (comma separated)" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        }
                        @if (property.EditorKind is DiagramPropertyEditorKinds.Text or DiagramPropertyEditorKinds.Multiline)
                        { <MudTextField @bind-Value="property.Placeholder" Label="Placeholder" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" /> }
                        @if (property.EditorKind is DiagramPropertyEditorKinds.Number or DiagramPropertyEditorKinds.Range)
                                                    { <MudTextField @bind-Value="property.Minimum" Label="Minimum" Margin="Margin.Dense" Immediate="true" Variant="Variant.Outlined" /><MudTextField @bind-Value="property.Maximum" Label="Maximum" Margin="Margin.Dense" Immediate="true" Variant="Variant.Outlined" /><MudTextField @bind-Value="property.Step" Label="Step" Margin="Margin.Dense" Immediate="true" Variant="Variant.Outlined" /> }
                        <MudCheckBox @bind-Value="property.Connectable" Label="Connectable" Dense="true" Class="designer-property-connectable" />
                        @if (property.Connectable)
                        {
                            <MudSelect T="string" @bind-Value="property.Direction" Label="Port" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("source")">Output (right)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("target")">Input (left)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("both")">Both</MudSelectItem>
                            </MudSelect>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveDraftProperty(property.Id))" aria-label="Remove property" />
                    </div>
                }
            </section>
            @if (!string.IsNullOrWhiteSpace(_designerError)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_designerError</MudAlert> }
            </div>
            <aside class="node-designer-preview-panel" aria-label="Node preview">
                <MudText Typo="Typo.overline">Live preview</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Matches the label, alignment, colors, and dimensions used on the canvas.</MudText>
            <div class="node-designer-preview" style="@($"--node-outline:{NormalizeColor(_draft.Outline, DefaultNodeOutline)};--node-background:{NormalizeColor(_draft.Background, DefaultNodeBackground)};--node-text:{NormalizeColor(_draft.TextColor, DefaultNodeTextColor)};--node-align:{NormalizeTextAlign(_draft.TextAlign)};--designer-node-width:{DesignerPreviewWidth}px;--designer-node-height:{DesignerPreviewHeight}px")">
                <div class="node-designer-preview-node">
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="designer-port port-top" OnClick="AddTopConnectionPoint" aria-label="Add top connection point" />
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="designer-port port-right" OnClick="AddRightConnectionPoint" aria-label="Add right connection point" />
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="designer-port port-bottom" OnClick="AddBottomConnectionPoint" aria-label="Add bottom connection point" />
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="designer-port port-left" OnClick="AddLeftConnectionPoint" aria-label="Add left connection point" />
                <div class="node-designer-card">
                    <div class="node-designer-card-header">
                        <span class="node-designer-card-title">@(string.IsNullOrWhiteSpace(_draft.Label) ? "Untitled" : _draft.Label)</span>
                    </div>
                </div>
                </div>
            </div>
            <MudText Typo="Typo.caption" Align="Align.Center" Class="node-designer-preview-metadata">@_draftPorts.Count connection point@(_draftPorts.Count == 1 ? string.Empty : "s")</MudText>

            <MudList T="string" Dense="true" Class="designer-port-list">
                @if (_draftPorts.Count == 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Outlined.TouchApp">Click a + on the preview to add a port.</MudListItem>
                }
                @foreach (var port in _draftPorts)
                {
                    <MudListItem T="string">
                        <div class="designer-port-row">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@port.Side</MudChip>
                            <MudSelect T="string" @bind-Value="port.Direction" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Class="port-direction-select">
                                <MudSelectItem T="string" Value="@("both")">Both</MudSelectItem>
                                <MudSelectItem T="string" Value="@("source")">Output</MudSelectItem>
                                <MudSelectItem T="string" Value="@("target")">Input</MudSelectItem>
                            </MudSelect>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveConnectionPoint(port.Id))" aria-label="Remove connection point" />
                        </div>
                    </MudListItem>
                }
            </MudList>
            </aside>
            </div>
        </div>
        <footer class="studio-modal-actions">
            <MudButton OnClick="CloseDesigner">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBox" OnClick="AddCustomTemplate">Add to palette</MudButton>
        </footer>
        </MudPaper>
        </div>
    }

    @if (_isPaletteGroupEditorOpen)
    {
        <div class="studio-modal-backdrop" @onclick="ClosePaletteGroupEditor">
        <MudPaper Class="studio-modal compact-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Add palette group" @onclick:stopPropagation="true">
            <header class="studio-modal-header">
                <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Class="mr-2" />New palette group</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClosePaletteGroupEditor" aria-label="Close palette group dialog" />
            </header>
            <div class="studio-modal-content">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Create a folder for organizing reusable node types. Removing it later moves its contents to Custom.</MudText>
                <MudTextField @bind-Value="_paletteGroupName" Label="Group name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" />
            </div>
            <footer class="studio-modal-actions">
                <MudButton OnClick="ClosePaletteGroupEditor">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="AddPaletteGroup">Add group</MudButton>
            </footer>
        </MudPaper>
        </div>
    }

    @if (_isStyleEditorOpen)
    {
        <div class="studio-modal-backdrop" @onclick="CloseStyleEditor">
        <MudPaper Class="studio-modal style-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Node style editor" @onclick:stopPropagation="true">
            <header class="studio-modal-header">
                <div>
                    <MudText Typo="Typo.overline">Selected node</MudText>
                    <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Palette" Class="mr-2" />@StyleNodeLabel</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseStyleEditor" aria-label="Close node style editor" />
            </header>
            <div class="studio-modal-content">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Adjust the node's visual style without changing its reusable palette definition.</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <div class="designer-color-field">
                            <label for="style-outline-color">Outline</label>
                            <div class="designer-color-control">
                                <input id="style-outline-color" type="color" @bind="_styleDraft.Outline" @bind:event="oninput" aria-label="Select outline color" />
                                <MudTextField @bind-Value="_styleDraft.Outline" Label="Hex" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <div class="designer-color-field">
                            <label for="style-background-color">Background</label>
                            <div class="designer-color-control">
                                <input id="style-background-color" type="color" @bind="_styleDraft.Background" @bind:event="oninput" aria-label="Select background color" />
                                <MudTextField @bind-Value="_styleDraft.Background" Label="Hex" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <div class="designer-color-field">
                            <label for="style-text-color">Text</label>
                            <div class="designer-color-control">
                                <input id="style-text-color" type="color" @bind="_styleDraft.TextColor" @bind:event="oninput" aria-label="Select text color" />
                                <MudTextField @bind-Value="_styleDraft.TextColor" Label="Hex" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect T="string" @bind-Value="_styleDraft.TextAlign" Label="Text alignment" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("left")">Left</MudSelectItem>
                            <MudSelectItem T="string" Value="@("center")">Center</MudSelectItem>
                            <MudSelectItem T="string" Value="@("right")">Right</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <div class="style-editor-preview" style="@($"--node-outline:{NormalizeColor(_styleDraft.Outline, DefaultNodeOutline)};--node-background:{NormalizeColor(_styleDraft.Background, DefaultNodeBackground)};--node-text:{NormalizeColor(_styleDraft.TextColor, DefaultNodeTextColor)};--node-align:{NormalizeTextAlign(_styleDraft.TextAlign)}")">
                    @StyleNodeLabel
                </div>
            </div>
            <footer class="studio-modal-actions">
                <MudButton OnClick="CloseStyleEditor">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="ApplyNodeStyleAsync">Apply style</MudButton>
            </footer>
        </MudPaper>
        </div>
    }

    @if (_isPropertiesEditorOpen)
    {
        <div class="studio-modal-backdrop" @onclick="CloseNodePropertiesEditor">
        <MudPaper Class="studio-modal properties-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Node properties and connections editor" @onclick:stopPropagation="true">
            <header class="studio-modal-header">
                <div><MudText Typo="Typo.overline">Selected node</MudText><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" />@PropertiesNodeLabel</MudText></div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseNodePropertiesEditor" aria-label="Close node properties editor" />
            </header>
            <div class="studio-modal-content properties-editor-content">
                @if (IsRegisteredPropertiesLocked)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">This registered node has a governed schema and ports. Property values and this node's presentation can change, but fields, sections, and connection points are locked.</MudAlert>
                }
                <section class="properties-editor-section" aria-label="Node presentation">
                    <div class="properties-editor-heading"><div><MudText Typo="Typo.subtitle1">Presentation</MudText><MudText Typo="Typo.caption">Current height is authoritative. Collapsing keeps the expanded height for restoration.</MudText></div><MudSwitch T="bool" @bind-Value="_presentationDraft.Enabled" Color="Color.Primary" Label="Use presentation state" /></div>
                    @if (_presentationDraft.Enabled)
                    {
                        <div class="presentation-editor-row">
                            <MudSelect T="string" @bind-Value="_presentationDraft.DisplayMode" Label="Node display" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined"><MudSelectItem Value="@DiagramNodeDisplayModes.Expanded">Expanded</MudSelectItem><MudSelectItem Value="@DiagramNodeDisplayModes.Compact">Compact</MudSelectItem><MudSelectItem Value="@DiagramNodeDisplayModes.Collapsed">Collapsed</MudSelectItem></MudSelect>
                            <MudNumericField T="double" @bind-Value="_presentationDraft.ExpandedHeight" Label="Expanded height" Margin="Margin.Dense" Min="48" Variant="Variant.Outlined" />
                        </div>
                        @if (_sectionEditorDrafts.Count > 0)
                        {
                            <div class="section-presentation-list" aria-label="Section visibility">
                                @foreach (var section in _sectionEditorDrafts)
                                {
                                    <div class="section-presentation-row" @key="section.Id"><div><MudText Typo="Typo.body2">@section.Title</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@(section.ParentSectionId is null ? "Top-level section" : "Nested section")</MudText></div>@if (section.Collapsible) { <MudSwitch T="bool" @bind-Value="section.Collapsed" Label="Collapsed" /> } else { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Always open</MudChip> }</div>
                                }
                            </div>
                        }
                    }
                </section>
                @if (!IsRegisteredPropertiesLocked)
                {
                    <section class="properties-editor-section" aria-label="Section hierarchy">
                        <div class="properties-editor-heading"><div><MudText Typo="Typo.subtitle1">Sections</MudText><MudText Typo="Typo.caption">Use a parent to nest a section; moving a property never changes its value.</MudText></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="AddEditorSection">Add section</MudButton></div>
                        @foreach (var section in _sectionEditorDrafts)
                        {
                            <div class="section-editor-row" @key="section.Id"><MudTextField @bind-Value="section.Title" Label="Section title" Margin="Margin.Dense" Variant="Variant.Outlined" /><MudSelect T="string" @bind-Value="section.ParentSectionId" Label="Parent" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Clearable="true">@foreach (var parent in _sectionEditorDrafts.Where(parent => parent.Id != section.Id)) { <MudSelectItem T="string" Value="@parent.Id">@parent.Title</MudSelectItem> }</MudSelect><MudCheckBox @bind-Value="section.Collapsible" Label="Collapsible" Dense="true" /><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveEditorSection(section.Id))" aria-label="Remove section" /></div>
                        }
                    </section>
                }
                <section class="properties-editor-section">
                    <div class="properties-editor-heading"><div><MudText Typo="Typo.subtitle1">Properties</MudText><MudText Typo="Typo.caption">Values appear on the node; connections create typed input/output ports.</MudText></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Disabled="@(IsRegisteredPropertiesLocked || _propertyEditorDrafts.Count >= MaxDesignedProperties)" OnClick="AddEditorProperty">Add property</MudButton></div>
                    @foreach (var property in _propertyEditorDrafts)
                    {
                        <div class="properties-editor-row" @key="property.Id">
                            <div class="property-reorder"><MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Disabled="@IsRegisteredPropertiesLocked" OnClick="@(() => MoveEditorProperty(property.Id, -1))" /><MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Disabled="@IsRegisteredPropertiesLocked" OnClick="@(() => MoveEditorProperty(property.Id, 1))" /></div>
                            <MudTextField @bind-Value="property.Name" Label="Name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Disabled="@IsRegisteredPropertiesLocked" />
                            @if (IsCustomPropertyType(property.Type))
                            {
                                <MudTextField Value="@property.Type" Label="Custom type" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="true" HelperText="Preserved without conversion" />
                            }
                            else
                            {
                                <MudSelect T="string" @bind-Value="property.Type" Label="Type" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked">
                                    <MudSelectItem Value="@DiagramPropertyTypes.String">Text</MudSelectItem>
                                    <MudSelectItem Value="@DiagramPropertyTypes.Boolean">Boolean</MudSelectItem>
                                    <MudSelectItem Value="@DiagramPropertyTypes.Integer">Integer</MudSelectItem>
                                    <MudSelectItem Value="@DiagramPropertyTypes.Decimal">Number</MudSelectItem>
                                    <MudSelectItem Value="@DiagramPropertyTypes.Date">Date</MudSelectItem>
                                    <MudSelectItem Value="@DiagramPropertyTypes.DateTime">Date/time</MudSelectItem>
                                    <MudSelectItem Value="@DiagramPropertyTypes.Enum">Choice</MudSelectItem>
                                    <MudSelectItem Value="@DiagramPropertyTypes.Json">JSON</MudSelectItem>
                                </MudSelect>
                            }
                            <MudSelect T="string" @bind-Value="property.Mode" Label="Mode" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked"><MudSelectItem Value="@DiagramPropertyModes.Display">Display</MudSelectItem><MudSelectItem Value="@DiagramPropertyModes.Edit">Edit</MudSelectItem><MudSelectItem Value="@DiagramPropertyModes.DisplayAndEdit">Display and edit</MudSelectItem><MudSelectItem Value="@DiagramPropertyModes.Hidden">Hidden</MudSelectItem></MudSelect>
                            @if (_sectionEditorDrafts.Count > 0)
                            { <MudSelect T="string" @bind-Value="property.SectionId" Label="Section" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked" Clearable="true">@foreach (var section in _sectionEditorDrafts) { <MudSelectItem T="string" Value="@section.Id">@section.Title</MudSelectItem> }</MudSelect> }
                            <MudSelect T="string" @bind-Value="property.EditorKind" Label="Editor" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked"><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Auto">Automatic</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Text">Text</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Multiline">Multiline</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Toggle">Toggle</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Number">Number</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Range">Range</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Date">Date</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.DateTime">Date/time</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Select">Select</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Color">Color</MudSelectItem><MudSelectItem T="string" Value="@DiagramPropertyEditorKinds.Json">JSON</MudSelectItem></MudSelect>
                            <MudTextField @bind-Value="property.Value" Label="Current value" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Disabled="@IsCustomPropertyType(property.Type)" />
                            @if (property.Type == DiagramPropertyTypes.Enum) { <MudTextField @bind-Value="property.Options" Label="Choices (comma separated)" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Disabled="@IsRegisteredPropertiesLocked" /> }
                            @if (property.EditorKind is DiagramPropertyEditorKinds.Text or DiagramPropertyEditorKinds.Multiline) { <MudTextField @bind-Value="property.Placeholder" Label="Placeholder" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked" /> }
                                        @if (property.EditorKind is DiagramPropertyEditorKinds.Number or DiagramPropertyEditorKinds.Range) { <MudTextField @bind-Value="property.Minimum" Label="Minimum" Margin="Margin.Dense" Immediate="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked" /><MudTextField @bind-Value="property.Maximum" Label="Maximum" Margin="Margin.Dense" Immediate="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked" /><MudTextField @bind-Value="property.Step" Label="Step" Margin="Margin.Dense" Immediate="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked" /> }
                            <MudSelect T="string" @bind-Value="property.Connection" Label="Connection" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked"><MudSelectItem Value="@("none")">None</MudSelectItem><MudSelectItem Value="@("target")">Input</MudSelectItem><MudSelectItem Value="@("source")">Output</MudSelectItem><MudSelectItem Value="@("both")">Both</MudSelectItem></MudSelect>
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" Disabled="@IsRegisteredPropertiesLocked" OnClick="@(() => RemoveEditorProperty(property.Id))" aria-label="Remove property" />
                        </div>
                    }
                </section>
                <section class="properties-editor-section">
                    <div class="properties-editor-heading"><div><MudText Typo="Typo.subtitle1">Unbound connection points</MudText><MudText Typo="Typo.caption">Ports not associated with a property.</MudText></div><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Disabled="@IsRegisteredPropertiesLocked" OnClick="AddEditorPort">Add connection point</MudButton></div>
                    @foreach (var port in _portEditorDrafts)
                    { <div class="unbound-port-row" @key="port.Id"><MudTextField @bind-Value="port.Label" Label="Label" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Disabled="@IsRegisteredPropertiesLocked" /><MudSelect T="string" @bind-Value="port.Side" Label="Side" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked"><MudSelectItem Value="@("left")">Left</MudSelectItem><MudSelectItem Value="@("right")">Right</MudSelectItem><MudSelectItem Value="@("top")">Top</MudSelectItem><MudSelectItem Value="@("bottom")">Bottom</MudSelectItem></MudSelect><MudSelect T="string" @bind-Value="port.Direction" Label="Direction" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Disabled="@IsRegisteredPropertiesLocked"><MudSelectItem Value="@("target")">Input</MudSelectItem><MudSelectItem Value="@("source")">Output</MudSelectItem><MudSelectItem Value="@("both")">Both</MudSelectItem></MudSelect><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" Disabled="@IsRegisteredPropertiesLocked" OnClick="@(() => RemoveEditorPort(port.Id))" aria-label="Remove connection point" /></div> }
                </section>
                @if (ConnectionsToRemove > 0) { <MudAlert Severity="Severity.Warning" Dense="true">Apply will remove @ConnectionsToRemove connection@(ConnectionsToRemove == 1 ? string.Empty : "s") attached to ports you removed.</MudAlert> }
                @if (!string.IsNullOrWhiteSpace(_propertiesEditorError)) { <MudAlert Severity="Severity.Error" Dense="true">@_propertiesEditorError</MudAlert> }
            </div>
            <footer class="studio-modal-actions"><MudButton OnClick="CloseNodePropertiesEditor">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="ApplyNodePropertiesAsync">Apply changes</MudButton></footer>
        </MudPaper></div>
    }

    @if (_isExportOpen)
    {
        <div class="studio-modal-backdrop" @onclick="CloseExport">
        <MudPaper Class="studio-modal export-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Exported SVG" @onclick:stopPropagation="true">
        <header class="studio-modal-header"><MudText Typo="Typo.h6">Exported SVG</MudText></header>
        <div class="studio-modal-content">
            <MudTextField T="string" Value="@_exportedSvg" Lines="18" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="export-field" />
        </div>
        <footer class="studio-modal-actions"><MudButton OnClick="CloseExport">Close</MudButton></footer>
        </MudPaper>
        </div>
    }

    @if (_isDeleteDiagramOpen && _deleteCandidate is not null)
    {
        <div class="studio-modal-backdrop" @onclick="CloseDeleteDiagram">
            <MudPaper Class="studio-modal compact-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Delete diagram" @onclick:stopPropagation="true">
                <header class="studio-modal-header">
                    <div><MudText Typo="Typo.h6">Delete diagram?</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">This permanently removes the saved diagram and its revision history.</MudText></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseDeleteDiagram" aria-label="Close delete diagram dialog" />
                </header>
                <div class="studio-modal-content"><MudAlert Severity="Severity.Warning" Dense="true">@_deleteCandidate.DisplayName cannot be recovered after deletion.</MudAlert></div>
                <footer class="studio-modal-actions">
                    <MudButton OnClick="CloseDeleteDiagram">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="DeleteDiagramAsync">Delete diagram</MudButton>
                </footer>
            </MudPaper>
        </div>
    }

    @if (_isImageExportOpen && _exportedImage is not null)
    {
        <div class="studio-modal-backdrop" @onclick="CloseImageExport">
        <MudPaper Class="studio-modal export-modal" Elevation="18" role="dialog" aria-modal="true" aria-label="Export diagram image" @onclick:stopPropagation="true">
        <header class="studio-modal-header"><div><MudText Typo="Typo.h6">Export diagram image</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">The PNG includes the whole diagram, including content outside the current viewport.</MudText></div></header>
        <div class="studio-modal-content"><img class="export-image-preview" src="@_exportedImage" alt="Preview of the complete diagram" /></div>
        <footer class="studio-modal-actions"><MudButton OnClick="CloseImageExport">Close</MudButton><a class="export-image-download" href="@_exportedImage" download="@ExportImageFileName"><MudIcon Icon="@Icons.Material.Filled.Download" Class="mr-1" />Download PNG</a></footer>
        </MudPaper>
        </div>
    }
</div>
