@namespace Ghostagram.Blazor
@using Ghostagram.Core

<CascadingValue Value="_nestedContext" IsFixed="true">@ChildContent</CascadingValue>

@code {
    [CascadingParameter] private DiagramCompositionContext Context { get; set; } = default!;
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter] public string? Label { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public double Width { get; set; } = 160;
    [Parameter] public double Height { get; set; } = 80;
    [Parameter] public bool Resizable { get; set; } = true;
    [Parameter] public bool Rotatable { get; set; } = true;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public DiagramNodeStyle? Style { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private DiagramCompositionContext _nestedContext = default!;

    protected override void OnInitialized()
    {
        Context.Add(new DiagramNode(Id, X, Y, Width, Height, Label, Context.GroupId, Resizable: Resizable, Rotatable: Rotatable, Icon: Icon, Style: Style));
        _nestedContext = Context.InNode(Id);
    }
}
