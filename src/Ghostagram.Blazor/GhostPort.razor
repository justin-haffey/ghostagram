@namespace Ghostagram.Blazor
@using Ghostagram.Core

@code {
    [CascadingParameter] private DiagramCompositionContext Context { get; set; } = default!;
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter] public string? NodeId { get; set; }
    [Parameter] public string Direction { get; set; } = "both";
    [Parameter] public string Scope { get; set; } = "*";
    [Parameter] public int MaxConnections { get; set; } = -1;
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public object? Anchor { get; set; }
    [Parameter] public DiagramEndpoint? Endpoint { get; set; }
    [Parameter] public DiagramConnectionPolicy? ConnectionPolicy { get; set; }
    [Parameter] public string? PropertyId { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public int Order { get; set; }

    protected override void OnInitialized()
    {
        var nodeId = NodeId ?? Context.NodeId ?? throw new InvalidOperationException("GhostPort must be nested in GhostNode or provide NodeId.");
        Context.Add(new DiagramPort(
            Id, nodeId, Direction, Scope, MaxConnections, Enabled, Anchor, Endpoint, ConnectionPolicy,
            PropertyId, Label, Order));
    }
}
