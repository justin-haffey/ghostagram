                     {
                         "category":  "workflow",
                         "name":  "orchestrate",
                         "slash":  "/orchestrate",
                         "description":  "Route a task through the dev-orchestrator with optional plan-only mode.",
                         "script":  "./workflow/orchestrate.ps1",
                         "examples":  [
                                          "/orchestrate investigate flaky builds -Prompt \"Coordinate a fix for the flaky coredev engineering workflow\"",
                                          "/orchestrate \"design a deployment workflow\" -Plan"
                                      ],
                         "parameters":  [
                                            {
                                                "name":  "\u003ccontext\u003e",
                                                "description":  "High-signal context, scope, or problem framing for the workstream.",
                                                "examples":  [
                                                                 "\"investigate flaky builds\"",
                                                                 "\"design a deployment workflow\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Prompt \u003cprompt\u003e",
                                                "description":  "Optional explicit instruction payload to send to the `dev-orchestrator`.",
                                                "examples":  [
                                                                 "-Prompt \"Coordinate a fix for the flaky coredev engineering workflow\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Plan",
                                                "description":  "Plan only; do not write code, edit files, or execute implementation work.",
                                                "examples":  [
                                                                 "-Plan"
                                                             ]
                                            }
                                        ]
                     }
                 ]
