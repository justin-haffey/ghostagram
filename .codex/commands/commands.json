{
    "commands":  [
                     {
                         "category":  "copilot",
                         "name":  "new-copilot",
                         "slash":  "/new-copilot",
                         "description":  "Route a Copilot package request through the copilot-orchestrator using the single-agent or multi-agent workflow.",
                         "script":  "./copilot/new-copilot.ps1",
                         "examples":  [
                                          "/new-copilot \"Create a policy analyst copilot for HR FAQs\" -Name \"hr-policy-analyst\"",
                                          "/new-copilot \"Create a customer support MAS\" -Name \"support-system\" -MAS -WhatIf"
                                      ],
                         "parameters":  [
                                            {
                                                "name":  "\u003cbrief\u003e",
                                                "description":  "Required user objective or package brief.",
                                                "examples":  [
                                                                 "\"Create an HR policy agent\"",
                                                                 "\"Create a multi-agent support system\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Name \u003cagent-name\u003e",
                                                "description":  "Optional canonical agent or system name.",
                                                "examples":  [
                                                                 "-Name \"hr-policy-agent\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Audience \u003ctext\u003e",
                                                "description":  "Optional target audience for the Copilot package.",
                                                "examples":  [
                                                                 "-Audience \"HR operations managers\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Domain \u003ctext\u003e",
                                                "description":  "Optional business or capability domain.",
                                                "examples":  [
                                                                 "-Domain \"Human resources policy\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Constraints \u003ctext\u003e",
                                                "description":  "Optional design or operating constraints.",
                                                "examples":  [
                                                                 "-Constraints \"Use knowledge-first grounding and no web search\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Mas",
                                                "description":  "Select the multi-agent workflow.",
                                                "examples":  [
                                                                 "-Mas"
                                                             ]
                                            },
                                            {
                                                "name":  "-WhatIf",
                                                "description":  "Resolve workflow, paths, and handoff data without generating output.",
                                                "examples":  [
                                                                 "-WhatIf"
                                                             ]
                                            }
                                        ]
                     },
                     {
                         "category":  "setup",
                         "name":  "move-agent",
                         "slash":  "/move-agent",
                         "description":  "Move an existing project-scoped Codex agent into a collection directory and update workspace references.",
                         "script":  "./setup/move-agent.ps1",
                         "examples":  [
                                          "/move-agent \"example-agent\" -Collection \"experimental\"",
                                          "/move-agent \"copilot-orchestrator\" -Collection \"copilot\" -Source \"legacy\""
                                      ],
                         "parameters":  [
                                            {
                                                "name":  "\u003cagent-name\u003e",
                                                "description":  "Existing agent identifier.",
                                                "examples":  [
                                                                 "\"example-agent\"",
                                                                 "\"copilot-orchestrator\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Collection \u003ccollection-name\u003e",
                                                "description":  "Destination collection directory under `.codex/agents/`.",
                                                "examples":  [
                                                                 "-Collection \"experimental\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Source \u003csource-collection-name\u003e",
                                                "description":  "Optional source collection directory used to narrow the search when the agent name is ambiguous.",
                                                "examples":  [
                                                                 "-Source \"legacy\""
                                                             ]
                                            }
                                        ]
                     },
                     {
                         "category":  "setup",
                         "name":  "new-agent",
                         "slash":  "/new-agent",
                         "description":  "Create a new project-scoped Codex agent from either a structured definition or a research brief.",
                         "script":  "./setup/new-agent.ps1",
                         "examples":  [
                                          "/new-agent -Research \"Create a Q# coding assistant agent\"",
                                          "/new-agent -AgentName \"Example Agent\" -PrimaryPurpose \"Handle one specific workflow well\" -WorkStyle mixed -MainTasks \"Task one; Task two\" -NonGoals \"Do not do X\" -PreferredModelBehavior balanced -SandboxPreference workspace-write -ToolsOrIntegrations none -SkillsNeeded none"
                                      ],
                         "parameters":  [
                                            {
                                                "name":  "-Research \u003ctext\u003e",
                                                "description":  "Research brief used to infer the agent definition.",
                                                "examples":  [
                                                                 "-Research \"Create a Q# coding assistant agent\""
                                                             ]
                                            },
                                            {
                                                "name":  "-Collection \u003cdirectory\u003e",
                                                "description":  "Optional collection directory under `.codex/agents/`.",
                                                "examples":  [
                                                                 "-Collection \"copilot\""
                                                             ]
                                            },
                                            {
                                                "name":  "-AgentName \u003cname\u003e",
                                                "description":  "Canonical agent name when creating from structured input.",
                                                "examples":  [
                                                                 "-AgentName \"Example Agent\""
                                                             ]
                                            },
                                            {
                                                "name":  "-PrimaryPurpose \u003cpurpose\u003e",
                                                "description":  "Primary objective or mission for the agent.",
                                                "examples":  [
                                                                 "-PrimaryPurpose \"Handle one specific workflow well\""
                                                             ]
                                            },
                                            {
                                                "name":  "-WorkStyle \u003cread-heavy|write-heavy|mixed\u003e",
                                                "description":  "Indicates whether the agent primarily consumes information, produces outputs, or balances both.",
                                                "examples":  [
                                                                 "-WorkStyle mixed"
                                                             ]
                                            },
                                            {
                                                "name":  "-MainTasks \u003ctext\u003e",
                                                "description":  "Core responsibilities, typically as a semicolon-separated list.",
                                                "examples":  [
                                                                 "-MainTasks \"Task one; Task two\""
                                                             ]
                                            },
                                            {
                                                "name":  "-NonGoals \u003ctext\u003e",
                                                "description":  "Boundaries or tasks the agent must avoid.",
                                                "examples":  [
                                                                 "-NonGoals \"Do not do X\""
                                                             ]
                                            },
                                            {
                                                "name":  "-PreferredModelBehavior \u003cspeed-first|balanced|deep-reasoning\u003e",
                                                "description":  "Desired tradeoff between latency and reasoning depth.",
                                                "examples":  [
                                                                 "-PreferredModelBehavior balanced"
                                                             ]
                                            },
                                            {
                                                "name":  "-SandboxPreference \u003cinherit|read-only|workspace-write|danger-full-access\u003e",
                                                "description":  "Execution environment preference for the agent.",
                                                "examples":  [
                                                                 "-SandboxPreference workspace-write"
                                                             ]
                                            },
                                            {
                                                "name":  "-ToolsOrIntegrations \u003ctext\u003e",
                                                "description":  "Tools or integrations required by the agent, or `none`.",
                                                "examples":  [
                                                                 "-ToolsOrIntegrations none",
                                                                 "-ToolsOrIntegrations \"Azure OpenAI; Microsoft Graph\""
                                                             ]
                                            },
                                            {
                                                "name":  "-SkillsNeeded \u003ctext\u003e",
                                                "description":  "Skills or competencies required by the agent, or `none`.",
                                                "examples":  [
                                                                 "-SkillsNeeded none",
                                                                 "-SkillsNeeded \"Prompt engineering; API integration\""
                                                             ]
                                            },
                                            {
                                                "name":  "-NicknameCandidates \u003ctext\u003e",
                                                "description":  "Optional alternate names for the agent.",
                                                "examples":  [
                                                                 "-NicknameCandidates \"SynthBot; DataWizard\""
                                                             ]
                                            },
                                            {
                                                "name":  "-ExtraConstraints \u003ctext\u003e",
                                                "description":  "Additional operational constraints.",
                                                "examples":  [
                                                                 "-ExtraConstraints \"Must avoid production changes\""
                                                             ]
                                            }
                                        ]
                     },
                     {
