                     {
                         "category":  "style-transfer",
                         "name":  "capture-style",
                         "slash":  "/capture-style",
                         "description":  "Extract a reusable STYLE_CARD from writing samples, including uploaded samples when present.",
                         "script":  "./style-transfer/capture-style.ps1",
                         "examples":  [
                                          "/capture-style .\\samples\\essay-1.md .\\samples\\essay-2.md -ContextPath .\\samples\\context.txt",
                                          "/capture-style .\\samples\\memo-1.md -OutFile .\\styles\\author-style.prompt.txt"
                                      ],
                         "parameters":  [
                                            {
                                                "name":  "\u003csample-file...\u003e",
                                                "description":  "One or more local writing-sample files when samples are not attached in the same message.",
                                                "examples":  [
                                                                 ".\\samples\\essay-1.md .\\samples\\essay-2.md"
                                                             ]
                                            },
                                            {
                                                "name":  "-ContextPath \u003cpath\u003e",
                                                "description":  "Optional file describing domain, audience, purpose, and taboo constraints.",
                                                "examples":  [
                                                                 "-ContextPath .\\samples\\context.txt"
                                                             ]
                                            },
                                            {
                                                "name":  "-OutFile \u003cpath\u003e",
                                                "description":  "Optional path to save the assembled prompt.",
                                                "examples":  [
                                                                 "-OutFile .\\styles\\author-style.prompt.txt"
                                                             ]
                                            }
                                        ]
                     },
                     {
                         "category":  "style-transfer",
                         "name":  "mimic-style",
                         "slash":  "/mimic-style",
                         "description":  "Generate new text from a STYLE_CARD with content and anti-copy guardrails.",
                         "script":  "./style-transfer/mimic-style.ps1",
                         "examples":  [
                                          "/mimic-style .\\styles\\author-style-card.md .\\briefs\\new-doc.md .\\drafts\\candidate-a.md",
                                          "/mimic-style .\\styles\\author-style-card.md .\\briefs\\new-doc.md -OutFile .\\prompts\\style-transfer.txt"
                                      ],
                         "parameters":  [
                                            {
                                                "name":  "\u003cstyle-card-file\u003e",
                                                "description":  "File containing the STYLE_CARD produced by `/capture-style`.",
                                                "examples":  [
                                                                 ".\\styles\\author-style-card.md"
                                                             ]
                                            },
                                            {
                                                "name":  "\u003cspec-file\u003e",
                                                "description":  "File containing the new document specification or rewrite brief.",
                                                "examples":  [
                                                                 ".\\briefs\\new-doc.md"
                                                             ]
                                            },
                                            {
                                                "name":  "[draft-file]",
                                                "description":  "Optional draft to evaluate with the style critic prompt.",
                                                "examples":  [
                                                                 ".\\drafts\\candidate-a.md"
                                                             ]
                                            },
                                            {
                                                "name":  "-OutFile \u003cpath\u003e",
                                                "description":  "Optional path to save the assembled prompt bundle.",
                                                "examples":  [
                                                                 "-OutFile .\\prompts\\style-transfer.txt"
                                                             ]
                                            }
                                        ]
                     },
